<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AppTimeMachine" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- Dark-mode splash keeps the same brand-indigo background so the
         mark stays recognizable regardless of system theme. -->
    <style name="Theme.AppTimeMachine.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/seed_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/seed_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.AppTimeMachine</item>
    </style>
</resources>
