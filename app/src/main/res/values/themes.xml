<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AppTimeMachine" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!-- Branded system splash (Android 12+ SplashScreen API, set as the
         launch theme in the manifest and consumed via
         installSplashScreen() in MainActivity). Brand-indigo background,
         white clock glyph, "Demoniter" as the window background icon —
         replaces what was previously a blank system-default flash. -->
    <style name="Theme.AppTimeMachine.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/seed_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/seed_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.AppTimeMachine</item>
    </style>
</resources>
